{{/* Generates a valid Algolia search index */}}
{{- $index := slice -}}
{{- $section := $.Site.GetPage "section" .Section }}
{{- range .Site.Pages -}}
{{- if or (and (.IsDescendant $section) (and (not .Draft) (not .Params.private))) $section.IsHome -}}
{{- $index = $index | append (dict "objectID" .File.UniqueID "description" (printf "%s, %s" (delimit (findRE "<a.*?>(.|\n)*?</a>" .TableOfContents) ", " | plainify) .Description) "lang" .Lang "permalink" .Permalink "summary" .Summary "title" .Title "weight" .Weight "version" (strings.Replace .Params.doc_version "docs_" ""))}}
{{- end -}}
{{- end -}}
{{- $index | jsonify -}}
